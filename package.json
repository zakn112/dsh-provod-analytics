{
  "name": "dsh-provod-analytics",
  "version": "0.3.1",
  "type": "module",
  "description": "Плагин DSH: панель расходов рабочего пространства Provod — остаток на счёте, суммы за сегодня и с начала месяца, прогноз и потребность до конца месяца, расходы по дням, ТОП-10 моделей и эффективность",
  "keywords": [
    "dsh-plugin",
    "provod",
    "analytics",
    "spending",
    "sidebar-panel"
  ],
  "license": "MIT",
  "author": "Provod Team",
  "homepage": "https://github.com/your-org/dsh-provod-analytics#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/dsh-provod-analytics.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/dsh-provod-analytics/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "PUBLISH.md",
    "lib/*.mjs",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.5"
  }
}
