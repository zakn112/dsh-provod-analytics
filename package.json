{
  "name": "dsh-provod-analytics",
  "version": "0.3.0",
  "type": "module",
  "description": "DSH plugin: Provod spending panel — account balance, today/month totals, month-end forecast and remaining need, daily breakdown, top-10 model costs and efficiency from the Provod analytics API",
  "keywords": [
    "dsh-plugin",
    "provod",
    "analytics",
    "spending",
    "sidebar-panel"
  ],
  "license": "MIT",
  "author": "Provod Team",
  "homepage": "https://github.com/your-org/dsh-provod-analytics#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/dsh-provod-analytics.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/dsh-provod-analytics/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "PUBLISH.md",
    "lib/*.mjs",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.5"
  }
}
